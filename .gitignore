# Dependencies (re-created by `npm install`, never commit)
node_modules/

# Build output (re-created by the build)
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/

# Secrets and local environment values
# Commit a `.env.example` with fake values instead.
.env
.env.*
!.env.example

# App data saved at runtime (bookings, estimate requests).
# It holds customers' names, phone numbers and addresses: never commit it.
data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python cache (created when skill scripts run)
__pycache__/
*.pyc

# Personal Claude Code files (shared ones live in .claude/ and CLAUDE.md)
.claude/settings.local.json
CLAUDE.local.md

# OS and editor clutter
.DS_Store
.idea/
