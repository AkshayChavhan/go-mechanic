# Dependencies (re-created by `npm install`, never commit)
node_modules/

# Build output (re-created by the build)
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/

# Secrets and local environment values
# Commit a `.env.example` with fake values instead.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python cache (created when skill scripts run)
__pycache__/
*.pyc

# Personal Claude Code files (shared ones live in .claude/ and CLAUDE.md)
.claude/settings.local.json
CLAUDE.local.md
# SEO hook state: fingerprints of the last reviewed page files
.claude/.seo-reviewed.json

# Deployment and certificates
.vercel
*.pem

# OS and editor clutter
.DS_Store
.idea/

# Compound Engineering: personal settings and scratch files
.compound-engineering/*.local.yaml
.context/compound-engineering/
.worktrees/
